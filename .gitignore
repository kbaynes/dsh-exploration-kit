# Build output
website/.vitepress/dist/
website/.vitepress/cache/
node_modules/
*.tsbuildinfo

# Exercise artifacts created while working the lessons.
# `plugins/*` (not `plugins/`) is required: git never descends into an excluded
# directory, so ignoring the directory itself would make the negation below dead
# and leave plugins/README.md untracked — breaking the links from examples/ and
# solutions/.
plugins/*
!plugins/README.md

# Generated site pages, synced from repository-root docs at build time.
# Canonical copies live at the root (VERIFIED.md, CONTRIBUTING.md, THIRD-PARTY.md).
content/VERIFIED.md
content/CONTRIBUTING.md
content/THIRD-PARTY.md

# Local environment
.DS_Store
.env
.env.*
*.log

# Bundle dependencies (installed per checkout; the manifest and lockfile are tracked)
kit-plugins/node_modules/

# Local reproductions of the full verification (see .github/workflows/verify-against-dsh.yml)
.dsh-checkout/
.dsh-bin/

# Written by Lesson 4's policy probe and by following the lesson's allow case.
l4-sandbox/
l4-sandbox-outside/
