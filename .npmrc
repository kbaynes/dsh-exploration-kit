# pnpm hoists nothing to the root node_modules by default (it symlinks only
# declared dependencies), and this repository's VitePress source root is
# ../content — outside website/. Node therefore cannot resolve `vue` from the
# markdown pages it compiles unless dependencies are hoisted.
#
# Verified on pnpm 11.7.0: without this, `pnpm run build` fails with
#   Rollup failed to resolve import "vue/server-renderer"
shamefully-hoist=true
strict-peer-dependencies=false
