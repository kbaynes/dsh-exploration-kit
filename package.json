{
  "name": "dsh-exploration-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A hands-on, nine-lesson curriculum for learning DeepSeek Harness by building real plugins.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.7.0",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "tutorial",
    "curriculum",
    "agents",
    "cordis"
  ],
  "//": "placeholder-check:allow  REPLACE BEFORE PUBLISHING: every 'REPLACE_OWNER' token in the repo must become the real GitHub owner. Run `pnpm run check:placeholders` to find them all. Existing sites: package.json repository/homepage/bugs, website/.vitepress/config.mts socialLinks, and .github/ISSUE_TEMPLATE/config.yml contact links.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE_OWNER/dsh-exploration-kit.git"
  },
  "homepage": "https://REPLACE_OWNER.github.io/dsh-exploration-kit/",
  "bugs": {
    "url": "https://github.com/REPLACE_OWNER/dsh-exploration-kit/issues"
  },
  "scripts": {
    "dev": "node scripts/sync-site-docs.mjs && vitepress dev website --host 127.0.0.1 --port 5173",
    "build": "node scripts/sync-site-docs.mjs && vitepress build website",
    "preview": "vitepress preview website --host 127.0.0.1 --port 4173",
    "validate": "okflint validate --manifest okf-base.yaml",
    "check:links": "node scripts/sync-site-docs.mjs && node scripts/check-links.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:upstream": "node scripts/check-upstream-links.mjs",
    "sync:site": "node scripts/sync-site-docs.mjs",
    "sync:examples": "node scripts/sync-examples.mjs",
    "check:examples": "node scripts/sync-examples.mjs --check",
    "check:decisions": "node scripts/check-decisions.mjs",
    "check:units": "cd kit-plugins && node --test l6/fold.test.mjs l8/audit-workflow.test.mjs",
    "check:kit": "node scripts/check-kit.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.13"
  },
  "kit": {
    "repositoryOwner": "REPLACE_OWNER",
    "repositoryName": "dsh-exploration-kit"
  }
}
